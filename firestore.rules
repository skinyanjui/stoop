rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'payments', 'savedIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'payments', 'savedIds', 'listingOrder', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && data.payments is list && data.payments.size() <= 15
        && (data.payments.size() == 0 || (data.payments[0] is string && data.payments[0].size() >= 1 && data.payments[0].size() <= 32))
        && data.savedIds is list && data.savedIds.size() <= 200
        && (data.savedIds.size() == 0 || (data.savedIds[0] is string && data.savedIds[0].size() >= 1 && data.savedIds[0].size() <= 128))
        && (!('listingOrder' in data) || (data.listingOrder is list && data.listingOrder.size() <= 200 && (data.listingOrder.size() == 0 || (data.listingOrder[0] is string && data.listingOrder[0].size() >= 1 && data.listingOrder[0].size() <= 128))))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPhotos(photos) {
      return photos is list && photos.size() <= 4
        && (photos.size() < 1 || (photos[0] is string && photos[0].size() <= 180000))
        && (photos.size() < 2 || (photos[1] is string && photos[1].size() <= 180000))
        && (photos.size() < 3 || (photos[2] is string && photos[2].size() <= 180000))
        && (photos.size() < 4 || (photos[3] is string && photos[3].size() <= 180000));
    }

    function isValidSale(data) {
      return data.keys().hasAll([
          'title', 'address', 'lat', 'lng', 'date', 'start', 'end',
          'saleType', 'cats', 'items', 'level', 'cur', 'food', 'drinks',
          'photos', 'pay', 'desc', 'status', 'ownerUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'address', 'lat', 'lng', 'date', 'start', 'end',
          'saleType', 'cats', 'items', 'prices', 'level', 'cur', 'food',
          'drinks', 'photos', 'pay', 'desc', 'status', 'ownerUid',
          'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.address is string && data.address.size() >= 1 && data.address.size() <= 200
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.start is string && data.start.size() == 5 && data.start.matches('^[0-9]{2}:[0-9]{2}$')
        && data.end is string && data.end.size() == 5 && data.end.matches('^[0-9]{2}:[0-9]{2}$')
        && data.saleType is string && data.saleType in ['Garage Sale', 'Flea Market', 'Car Boot Sale']
        && data.cats is list && data.cats.size() >= 1 && data.cats.size() <= 40
        && data.cats[0] is string && data.cats[0].size() >= 1 && data.cats[0].size() <= 60
        && data.items is list && data.items.size() <= 30
        && (data.items.size() == 0 || (data.items[0] is string && data.items[0].size() <= 80))
        && (!('prices' in data) || (data.prices is map && data.prices.size() <= 30))
        && data.level is number && data.level >= 0 && data.level <= 3
        && data.cur is string && data.cur.size() == 3
        && data.food is bool
        && data.drinks is bool
        && isValidPhotos(data.photos)
        && data.pay is list && data.pay.size() <= 15
        && (data.pay.size() == 0 || (data.pay[0] is string && data.pay[0].size() <= 32))
        && data.desc is string && data.desc.size() <= 2000
        && data.status is string && data.status == 'active'
        && data.ownerUid is string && data.ownerUid == request.auth.uid && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isEmailVerified()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUser(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'payments', 'savedIds', 'listingOrder', 'updatedAt']);
      allow delete: if isEmailVerified() && isValidId(userId) && isOwner(userId);
    }

    match /sales/{saleId} {
      allow get: if isValidId(saleId) && resource != null && existing().status == 'active';
      allow list: if existing().status == 'active';
      allow create: if isEmailVerified()
        && isValidId(saleId)
        && isValidSale(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified()
        && isValidId(saleId)
        && isValidSale(incoming())
        && isOwner(existing().ownerUid)
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'address', 'lat', 'lng', 'date', 'start', 'end',
          'saleType', 'cats', 'items', 'prices', 'level', 'cur', 'food', 'drinks',
          'photos', 'pay', 'desc', 'updatedAt'
        ]);
      allow delete: if isEmailVerified() && isValidId(saleId) && isOwner(existing().ownerUid);
    }
  }
}
